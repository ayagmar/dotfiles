#!/usr/bin/env python3
"""Manage retention limits while preserving the existing Snapper configuration."""

import re
import sys

limits = {
    "TIMELINE_LIMIT_HOURLY": 6,
    "TIMELINE_LIMIT_DAILY": 7,
    "TIMELINE_LIMIT_WEEKLY": 4,
    "TIMELINE_LIMIT_MONTHLY": 2,
    "TIMELINE_LIMIT_YEARLY": 0,
    "NUMBER_LIMIT": 10,
    "NUMBER_LIMIT_IMPORTANT": 5,
}

config = sys.stdin.read()
for key, value in limits.items():
    pattern = rf'(?m)^([ \t]*{key}[ \t]*=[ \t]*)(?:"[^"]*"|[^#\r\n]*?)([ \t]*(?:#[^\r\n]*)?)$'
    config, count = re.subn(pattern, lambda m: f'{m[1]}"{value}"{m[2]}', config)
    if count != 1:
        sys.exit(f"Expected exactly one {key} assignment in existing Snapper config")

sys.stdout.write(config)
