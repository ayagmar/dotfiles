{
  "lastChangelogVersion": "1.2.0",
  "packages": [
    "npm:pi-promptsmith",
    "npm:pi-extmgr",
    "https://github.com/davebcn87/pi-autoresearch",
    "git:github.com/edxeth/pi-gpt-config",
    "git:github.com/ayagmar/pi-message-recall",
    "git:git@github.com:ayagmar/pi-codex-web-search.git",
    "git:git@github.com:elidickinson/pi-claude-bridge.git"
  ],
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4.1-flash",
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": true,
  "theme": "system/noctalia-noctalia-default",
  "gptConfig": {
    "fastMode": true,
    "personality": "none",
    "verbosity": "low",
    "summary": "auto",
    "showFooter": true
  }
}
