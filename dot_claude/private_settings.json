{
  "cleanupPeriodDays": 36500,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "SendFeedback",
      "ListAgents"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:skill-creator": "name-only",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "code-review": "user-invocable-only",
    "loop": "user-invocable-only",
    "schedule": "user-invocable-only",
    "run": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "workflow-authoring": "user-invocable-only",
    "dataviz": "name-only",
    "claude-api": "name-only",
    "update-config": "name-only",
    "summarize": "off",
    "grilling": "off",
    "grill-me": "off",
    "draft-coach": "off",
    "fframes-video": "name-only",
    "product-spec-foundry": "name-only",
    "advisor-executor-quality-loop": "name-only",
    "release-readiness-certification": "name-only",
    "brag": "name-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/ayagmar/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "ccdesk hook --run",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ayagmar/.atuin/bin/atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ayagmar/.atuin/bin/atuin hook claude-code"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/home/ayagmar/.claude/skills/impeccable/scripts/impeccable' ] || '/home/ayagmar/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ayagmar/.atuin/bin/atuin hook claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/home/ayagmar/.claude/skills/impeccable/scripts/impeccable' ] || '/home/ayagmar/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "modmgr@ayagmar": true,
    "embers@ayagmar": true
  },
  "extraKnownMarketplaces": {
    "ayagmar": {
      "source": {
        "source": "github",
        "repo": "ayagmar/claude-mods"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    },
    "claude-fable-5-2": {
      "effortLevel": "low"
    }
  },
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "modmgr@ayagmar": {
      "options": {
        "updateCheckHours": 6,
        "detectRemote": true,
        "debugTimings": false,
        "notifyUpdates": true
      }
    },
    "embers@ayagmar": {
      "options": {
        "ttlMinutes": 60,
        "marginMinutes": 5,
        "coldMode": "ask",
        "offerOnStart": true,
        "showBand": true
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "idleCompaction": false,
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
