[user]
	name = Abdeslam Yassine Agmar
	email = abdeslamagmar@gmail.com
	signingkey = /home/ayagmar/.ssh/id_github_ayagmar.pub
[init]
	defaultBranch = master
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /home/ayagmar/.ssh/allowed_signers
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gitlab-df-main.gos.orange.com"]
	username = aagmar
	helper = libsecret
[credential "https://abdeslam-agmar-nw@github.com"]
	helper =
	helper = !GH_CONFIG_DIR=/home/ayagmar/.config/gh-theodo /usr/bin/gh auth git-credential
[push]
	autoSetupRemote = true
[alias]
	sync-fork = "!f() { git fetch upstream || return; git rev-parse -q --verify refs/remotes/upstream/HEAD >/dev/null || git remote set-head upstream --auto >/dev/null || return; b=$(git rev-parse --abbrev-ref upstream/HEAD); b=${b#upstream/}; git switch \"$b\" && git merge --ff-only \"upstream/$b\" && git push origin \"$b\"; }; f"
[includeIf "gitdir:~/projects/orange/"]
	path = ~/.gitconfig-orange
[includeIf "gitdir:~/projects/theodo/"]
	path = ~/.gitconfig-theodo
