#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  start-shell)
    exec noctalia --daemon
    ;;
  restart-shell)
    if pgrep -x noctalia >/dev/null; then
      pkill -x noctalia
      sleep 0.2
    fi
    exec noctalia --daemon
    ;;
  *)
    echo "usage: noctaliactl <start-shell|restart-shell>" >&2
    exit 2
    ;;
esac
