#!/bin/sh
set -eu

# Mod+B should land on the running Helium window. A bare Chromium launch hands
# the request to the already-running browser process, which then opens a fresh
# window for it, so ask niri for an existing Helium window first and focus that
# instead. Arguments are passed through untouched, so a URL from xdg-open still
# goes to the running browser.

if [ "$#" -eq 0 ]; then
    window_id="$(
        niri msg --json windows 2>/dev/null |
            jq -r 'map(select(.app_id == "helium"))
                   | sort_by([.focus_timestamp.secs, .focus_timestamp.nanos])
                   | last | .id // empty' 2>/dev/null || true
    )"
    if [ -n "$window_id" ] && niri msg action focus-window --id "$window_id"; then
        exit 0
    fi
fi

exec "$HOME/.local/bin/helium-browser-detached" "$@"
